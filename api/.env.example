# SpotSure API — server-side settings. Copy to .env and adjust.
# These are never exposed to the Vite frontend; do not prefix with VITE_.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Local Postgres from `npm run db:dev` or `docker compose up -d db` (same URL).
DATABASE_URL=postgres://spotsure:spotsure@localhost:5433/spotsure
DATABASE_POOL_MAX=10
# Used only by the test suite; DB tests are skipped when unset.
TEST_DATABASE_URL=postgres://spotsure:spotsure@localhost:5433/spotsure_test

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Stricter per-IP limit for login and registration.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Booking requests per client per hour.
BOOKING_RATE_LIMIT_MAX=30

# Browser sessions (HttpOnly cookie, server-side record).
SESSION_TTL_HOURS=168
# Leave blank: Secure cookies are on automatically when NODE_ENV=production
# and cannot be turned off there. Local http dev runs without Secure.
SESSION_COOKIE_SECURE=
# true when behind a reverse proxy/load balancer, so rate limits see client IPs.
TRUST_PROXY=false

# Production: path to the built web app (npm run build at the repo root -> dist).
# When set, the API serves the site too, so app and API share one origin.
WEB_DIST_DIR=

# Listing photos. Local disk for development (any persistent directory).
# Leave blank to disable uploads: the API then answers 503, never a fake success.
# Production should use object storage (S3-compatible driver not implemented yet).
PHOTO_STORAGE_DIR=./.storage/photos
PHOTO_MAX_BYTES=5000000

# Live charges. No payment provider is integrated: "none" is the only accepted
# value and the API refuses to start with anything else (e.g. "dodo").
PAYMENTS_PROVIDER=none

# Integrations — leave blank until a real configuration exists.
FIREBASE_PROJECT_ID=
# Path to a service-account JSON kept outside the repo.
FIREBASE_SERVICE_ACCOUNT_PATH=
YOLO_SERVICE_URL=
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH=
TIGERGRAPH_SECRET=
WEB3_RPC_URL=
WEB3_CHAIN_ID=
