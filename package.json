{
  "name": "spotsure",
  "version": "0.1.0",
  "private": true,
  "description": "SpotSure — smart parking intelligence. Landing page.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api:dev": "npm --prefix api run dev",
    "api:test": "npm --prefix api test",
    "db:dev": "npm --prefix api run db:dev",
    "build:all": "npm run build && npm --prefix api run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
